{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "type": "lldb",
            "request": "launch",
            "name": "Debug executable 'x' Run on device",
            "cargo": {
                "args": [
                    "build",
                    "--bin=x",
                    "--package=xbuild"
                ],
                "filter": {
                    "name": "x",
                    "kind": "bin"
                }
            },
            "args": ["run", "--device", "adb:R5CR600V9TM", "--verbose", "--release"],
            "cwd": "${workspaceFolder}/../weather"
        },
        {
            "type": "lldb",
            "request": "launch",
            "name": "Debug executable 'x' Create Apk",
            "cargo": {
                "args": [
                    "build",
                    "--bin=x",
                    "--package=xbuild"
                ],
                "filter": {
                    "name": "x",
                    "kind": "bin"
                }
            },
            "env": {
                //"X_PEM": ""
            },
            "args": ["build", "--release", "--platform", "android", "--format", "apk", "--arch", "arm64"], // , "--pem", "/home/martin/Dokumente/pem"
            "cwd": "${workspaceFolder}/../weather"
        },
    ]
}